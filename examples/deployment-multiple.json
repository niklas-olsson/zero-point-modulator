{
  "schema_version": 2,
  "deployment_id": "my-deployment",
  "max_workers": 2,
  "sources": {
    "zpm": {
      "checkout": "/absolute/checkouts/zero-point-modulator",
      "revision": "REPLACE_WITH_FULL_TESTED_GIT_COMMIT"
    },
    "openjules": {
      "checkout": "/absolute/checkouts/OpenJules",
      "revision": "REPLACE_WITH_FULL_TESTED_GIT_COMMIT"
    },
    "polyphony": {
      "checkout": "/absolute/checkouts/keystone-polyphony",
      "revision": "REPLACE_WITH_FULL_TESTED_GIT_COMMIT"
    }
  },
  "ports": {
    "polyphony": 8766,
    "openjules": 8000
  },
  "repositories": [
    {
      "binding": {
        "schema_version": 1,
        "repository": "github:github.com/owner/project-a",
        "profile": "approved-project-a-v1",
        "desired_workers": 0,
        "max_workers": 2
      },
      "source": {
        "checkout": "/absolute/checkouts/project-a",
        "revision": "REPLACE_WITH_FULL_APPROVED_BASE_COMMIT"
      },
      "image": "sha256:REPLACE_WITH_FULL_APPROVED_IMAGE_ID",
      "command": [
        "python3",
        "approved_offline_agent.py"
      ],
      "policy": {
        "checks": [
          "tests"
        ],
        "reviewers": [
          "operator"
        ],
        "max_attempts": 3,
        "budget_seconds": 600,
        "attempt_seconds": 120,
        "capabilities": [
          "python"
        ]
      },
      "environment_refs": {
        "OPENAI_API_KEY": "env:PROJECT_A_OPENAI_KEY"
      }
    },
    {
      "binding": {
        "schema_version": 1,
        "repository": "github:github.com/owner/project-b",
        "profile": "approved-project-b-v1",
        "desired_workers": 0,
        "max_workers": 2
      },
      "source": {
        "checkout": "/absolute/checkouts/project-b",
        "revision": "REPLACE_WITH_FULL_APPROVED_BASE_COMMIT"
      },
      "image": "sha256:REPLACE_WITH_FULL_APPROVED_IMAGE_ID",
      "command": [
        "python3",
        "approved_offline_agent.py"
      ],
      "policy": {
        "checks": [
          "tests"
        ],
        "reviewers": [
          "operator"
        ],
        "max_attempts": 3,
        "budget_seconds": 600,
        "attempt_seconds": 120,
        "capabilities": [
          "python"
        ]
      },
      "environment_refs": {
        "OPENAI_API_KEY": "env:PROJECT_B_OPENAI_KEY"
      }
    }
  ]
}
