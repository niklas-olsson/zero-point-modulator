{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZPM sealed Python dependency plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "interpreter", "seed", "artifacts", "environments"],
  "properties": {
    "schema_version": {"const": 1},
    "interpreter": {
      "type": "object", "additionalProperties": false,
      "required": ["implementation", "version", "cache_tag", "abi", "platform"],
      "properties": {
        "implementation": {"const": "cpython"},
        "version": {"type": "string", "pattern": "^3\\.(11|12)\\.[0-9]+$", "maxLength": 128},
        "cache_tag": {"type": "string", "minLength": 1, "maxLength": 128},
        "abi": {"type": "string", "minLength": 1, "maxLength": 128},
        "platform": {"type": "string", "pattern": "^linux-", "maxLength": 128}
      }
    },
    "seed": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "filename"],
      "properties": {"method": {"const": "sealed-pip-wheel"}, "filename": {"$ref": "#/$defs/wheel"}}
    },
    "artifacts": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"$ref": "#/$defs/artifact"}},
    "environments": {
      "type": "object", "additionalProperties": false,
      "required": ["zpm", "openjules", "polyphony"],
      "properties": {
        "zpm": {"$ref": "#/$defs/environment"},
        "openjules": {"$ref": "#/$defs/environment"},
        "polyphony": {"$ref": "#/$defs/environment"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "wheel": {"type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.+!-]{0,240}\\.whl$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["filename", "size", "sha256", "name", "version"],
      "properties": {
        "filename": {"$ref": "#/$defs/wheel"},
        "size": {"type": "integer", "minimum": 1, "maximum": 134217728},
        "sha256": {"$ref": "#/$defs/sha256"},
        "name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["source_revision", "dependency_files", "wheels"],
      "properties": {
        "source_revision": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        "dependency_files": {
          "type": "object", "minProperties": 1, "maxProperties": 1,
          "additionalProperties": false,
          "properties": {"pyproject.toml": {"$ref": "#/$defs/sha256"}, "requirements.txt": {"$ref": "#/$defs/sha256"}}
        },
        "wheels": {"type": "array", "minItems": 1, "maxItems": 512, "uniqueItems": true, "items": {"$ref": "#/$defs/wheel"}}
      }
    }
  }
}
